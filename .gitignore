# Windmill
**/windmill/local

# Persistent volume data. Every volume lives here, declared in its service's
# x-exist-volumes block and created by generate-compose.ts for the services that
# are actually enabled — so nothing inside is tracked and there are no .gitkeep
# files to trip over when you delete a volume.
volumes/
# immich keeps its DB off NFS in a second tree, named in its own upstream-env
# .env (DB_DATA_LOCATION) rather than in x-exist-volumes.
volumes_local/

# Service-dir scratch that is NOT a volume: hermes' runtime, extracted from the
# image by its exist.initial.sh.
**/hermes_install
**/model-cache
**/caddy_config
**/ntfy_cache

# OS / editor droppings
.DS_Store
Thumbs.db
*.swp

# e2e evidence — one directory per run, copied out of the clone before teardown
/e2e-out/
