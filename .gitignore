**/.env
**/.env.local
**/.env.generated
/.env.shared
/.claude/worktrees

# Temp files created by existential.sh and e2e tests (always inside the repo)
/.tmp.*
/.tmp-e2e-*

# Per-service "exist.initial.sh has run" sentinel
**/.existential.initialized
**/.pnpm-store
.claude/settings.local.json

**/n8n_data
**/nextcloud_data
**/nextcloudsql_data
**/pg_data
**/qdrant_data
**/speaches_data

**/node_modules

**/docker-compose.yml
!site/docker-compose.yml
/docker-compose-*.yml

# `./existential.sh reset` moves rendered config here, paths preserved.
# Never pruned automatically — it is the undo for a reset.
/archive/

# Bridge Config
**/bridge.config.json

# Chatterbox
**/chatterbox/config.yaml
**/chatterbox/logs
**/chatterbox/outputs

# Caddy
**/Caddyfile

# Caddy TLS certs (hosting/caddy/certs/) — nothing in there is tracked.
# Cloudflare origin pair (user-supplied):
**/cloudflare-key.pem
**/cloudflare.pem
# Your own public-domain wildcard pair (Caddyfile.frontdoor-public.example):
**/public-key.pem
**/public.pem
# Stable *.internal cert + CA, minted by caddy/exist.initial.sh (keys are secret;
# certs are host-local generated artifacts — none are committed):
**/internal-ca-key.pem
**/internal-ca.pem
**/internal-key.pem
**/internal.pem
**/internal.csr
**/internal-ca.srl

# Code-server
# Nothing renders opencode.json any more (the stack ships no opencode config),
# but installs from before that carry a leftover copy holding the hermes API
# key. Keep it ignored so a stale one can never be committed.
**/opencode.json

# The workspace now lives in volumes/workspace_data, but installs from before
# that carry a leftover repo-root copy of user files. Keep it ignored.
/workspace

# Dashy
# dashy-conf.yml is regenerated on every run, unless the user claims it by
# flipping EXIST_KEEP to true in its header — either way it is theirs, not ours.
**/dashy-conf.yml

# Decree
# automation/ is what the repo ships into workspace/.decree (the `automation`
# daemon's project); its cron/, migrations/, runs/ and the rest below are only
# what an install from before that left behind. services/automation/backup/ is
# the second project and keeps its own runtime state.
automation/lib/file-processors/*
automation/cron/*
automation/migrations/*
automation/runs/*
automation/store/
automation/secrets/*
automation/data/*
automation/emails/
automation/inbox/*
automation/processed.md
services/automation/backup/cron/*
services/automation/backup/data/*
services/automation/backup/inbox/*
services/automation/backup/runs/*
services/automation/backup/store/
services/automation/backup/processed.md
# automation-backup mounts automation/lib and automation/scripts into its own
# project, so these two are only mount points.
services/automation/backup/lib/*
services/automation/backup/scripts/
# decree 0.4 leftovers exist.initial.sh cannot always remove: the Go webhook's
# root-owned binary, and the old shared_routines/ and outbox/ mount points.
services/automation/webhook/
services/automation/backup/shared_routines/
automation/outbox/
services/automation/backup/outbox/


# LightRAG
**/lightrag/rag_storage

# Immich
**/immich/library
**/immich/postgres

# LibreChat (graveyard)
**/librechat/data-node
**/librechat/logs
**/librechat/meili_data_v1.12
**/librechat/uploads
**/librechat/librechat.yaml

# Nextcloud
**/nextcloud/servername.conf
# The entrypoint writes the redis password into it on every start.
**/nextcloud/redis-session.ini

# NTFY
**/ntfy-config/server.yml
**/ntfy-config/user.db
**/mqtfy-config.yml

# Honcho
**/honcho/config.toml
# Nothing renders this any more — the honcho plugin config is written straight
# into hermes' volume by ai/hermes/exist.initial.sh, which is the only consumer.
# Kept ignored so a leftover copy from an older install can never be committed.
**/honcho/honcho.json

# Playwright MCP scratch output (screenshots, traces)
**/.playwright-mcp/
node_modules/
/automation/playwright/test-results/
/automation/playwright/playwright-report/
/automation/playwright/blob-report/
/automation/playwright/playwright/.cache/

# Portainer
**/portainer/portainer_password*
!**/portainer/portainer_password.exist.txt

# RabbitMQ
**/ssl/ca.pem
**/ssl/client*
**/ssl/server_cert.pem
**/ssl/server_key.pem
**/rabbitMQ/defs.json

# StirlingPDF
**/StirlingPDF

# VLLM
**/vllm/.env

# Windmill
**/windmill/local

# Persistent volume data. Every volume lives here, declared in its service's
# x-exist-volumes block and created by generate-compose.ts for the services that
# are actually enabled — so nothing inside is tracked and there are no .gitkeep
# files to trip over when you delete a volume.
volumes/

# OS / editor droppings
.DS_Store
Thumbs.db
*.swp

# e2e evidence — one directory per run, copied out of the clone before teardown
/e2e-out/
