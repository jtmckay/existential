# Bearer token for the gateway's OpenAI-compatible API on :8642. Blank leaves
# https://hermes-agent.<domain> open to anyone who can resolve it.
HERMES_API_KEY=EXIST_HERMES_API_KEY

# Basic-auth credentials for the dashboard on :9119. The dashboard refuses any
# non-loopback bind without an auth provider (HERMES_DASHBOARD_INSECURE no
# longer waives that), so blanks leave it unbound and the healthcheck failing.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=EXIST_USERNAME
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=EXIST_PASSWORD

# Optional: a hosted provider instead of the stack's ollama. Uncomment ONE and
# point config.yaml's model.provider at it — see site/docs/ai/hermes.md.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
