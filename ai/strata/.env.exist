# strata — which model pack it downloads. The API key is EXIST_MODEL_API_KEY in .env.shared.
# Packs and sizes: https://existential.company/docs/ai/strata

# Model family: qwen, qwen36, coder, gyro, unsloth, hy4-flash, inkling-2-mini, nvfp4. Blank lets strata pick for the card.
STRATA_FAMILY=

# Size within the family (IQ3_XXS for qwen, UD-Q4_K_XL for qwen36…). Blank lets strata pick; it must fit the 64G memory limit.
STRATA_MODEL=
