# Seconds between index refreshes; a saved note is searchable within about this long.
QMD_REFRESH_SECONDS=60
# Blank = embeddinggemma-300M; another hf: GGUF URI re-embeds everything once (site/docs/ai/qmd.md).
QMD_EMBED_MODEL=
# Extra comma-separated globs to keep out of search, on top of every .gitignore in the workspace.
QMD_IGNORE=
