# ollama — VRAM scheduling. Models themselves are NOT set here: model choice is
# global, in the "Model Selection" block of .env.shared (see site/docs/configuration.md).

# Models kept in VRAM at once. 2 = chat + embeddings, which is what the tier table budgets for; a third load OOMs an 8 GB card mid-generation.
OLLAMA_MAX_LOADED_MODELS=2

# How long an idle model stays loaded. Shorter and every request pays a reload; longer and a one-off vision job pins VRAM it no longer needs.
OLLAMA_KEEP_ALIVE=10m

# Concurrent generations. Each one gets its own KV cache, so >1 is what actually blows the VRAM budget on a small card.
OLLAMA_NUM_PARALLEL=1

# KV cache precision (f16 | q8_0 | q4_0). q8_0 roughly halves the 64k cache when `run ollama test` reports no headroom, at a small quality cost.
OLLAMA_KV_CACHE_TYPE=f16
