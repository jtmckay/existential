# Chatterbox TTS Server Configuration

# Host port for the optional direct mapping; only used if the `ports:` block in docker-compose.exist.yml is uncommented — otherwise access is via https://chatterbox.<EXIST_DOMAIN>.
CHATTERBOX_PORT=48004

# HuggingFace token, only needed if you point model.repo_id at a gated repo; blank is fine for the stock ResembleAI weights.
CHATTERBOX_HF_TOKEN=
