# OpenViking — root API key (used by MCP clients, REST API, and exist.mcp.sh)
OPENVIKING_API_KEY=EXIST_32_CHAR_HEX_KEY

# Embedding model served by Ollama — must be pulled before starting openviking.
# Both values come from the "Model Selection" block in .env.shared so honcho,
# the ollama migrations and this service can never disagree about the model.
# The decree daemon's `embed` migration pulls whatever EXIST_MODEL_EMBED names.
OPENVIKING_EMBEDDING_MODEL=EXIST_MODEL_EMBED

# Embedding dimension — must match the model above (bge-m3 → 1024,
# nomic-embed-text → 768, mxbai-embed-large → 1024).
#
# WARNING: changing the model after first ingestion corrupts the vector index.
# Wipe volumes/openviking_data if you change it.
OPENVIKING_EMBEDDING_DIM=EXIST_MODEL_EMBED_DIM
