{
  "$schema": "https://opencode.ai/config.json",
  "model": "hermes/hermes-agent",
  "permission": {
    "bash": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    }
  },
  "provider": {
    "hermes": {
      "name": "hermes-agent (default profile)",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "hermes-agent": { "_launch": true, "name": "hermes-agent" } },
      "options": {
        "baseURL": "http://hermes-agent:8642/v1",
        "apiKey": "EXIST_HERMES_API_KEY"
      }
    }
  }
}
