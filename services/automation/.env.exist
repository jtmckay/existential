# Directories
AUTOMATION_NOTES_DIR=Somewhere/Something
AUTOMATION_DROPBOX_DEST_DIR=Somewhere/Something

# Gmail sync (see services/automation/gmail/README.md for setup)
# AUTOMATION_GMAIL_INITIAL_SYNC_DAYS=7
# AUTOMATION_GMAIL_LABEL_FILTER=INBOX

# Claude for machines, instead of signing in with `docker exec -it automation claude` (blank = that login)
AUTOMATION_ANTHROPIC_API_KEY=
# A token from `claude setup-token`, for a Claude subscription (blank = the login above)
AUTOMATION_CLAUDE_CODE_OAUTH_TOKEN=
# What a machine's Claude may do unasked: auto, acceptEdits, default (read only) (blank = auto)
AUTOMATION_CLAUDE_PERMISSION_MODE=
