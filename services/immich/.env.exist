# convention-exempt: upstream-env
# This file is loaded directly via `env_file:` in docker-compose. Keys must
# match the upstream Immich names exactly — no IMMICH_ prefix.
#
# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# Storage is NOT configured here. The photo library and the database are declared
# volumes (immich_data, immich_pg_data) in docker-compose.exist.yml, like every
# other service — so they live under volumes/, automation-backup can see them,
# and EXIST_NFS_PATH_IMMICH_DATA is what puts the library on the NAS. The old
# UPLOAD_LOCATION / DB_DATA_LOCATION keys are gone; if they are still in your
# rendered .env from an older install they are simply unused.

# The web and phone login, created by the photos flow's immich_setup migration; change it in Immich afterward if you want.
IMMICH_ADMIN_EMAIL=EXIST_EMAIL
IMMICH_ADMIN_NAME=EXIST_USERNAME
IMMICH_ADMIN_PASSWORD=EXIST_PASSWORD

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v3.1.0" —
# v3 matches upstream's own current default. The server only talks to the matching
# major version of the mobile app; see docs.immich.app/install/upgrading before
# crossing a major version on an existing (non-fresh) install.
IMMICH_VERSION=v3

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=EXIST_24_CHAR_PASSWORD

###################################################################################
DB_HOSTNAME=immich-postgres
DB_USERNAME=EXIST_USERNAME
DB_DATABASE_NAME=immich

REDIS_HOSTNAME=immich-redis
