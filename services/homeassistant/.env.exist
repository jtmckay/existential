# Timezone for HA's own logs/automations; wrong value only shifts displayed times.
HOMEASSISTANT_TZ=America/Chicago
# Web UI login at https://homeassistant.<domain> — created automatically by
# the homeassistant-onboarding decree migration; change it in HA afterward if you want.
HOMEASSISTANT_ADMIN_USER=EXIST_USERNAME
HOMEASSISTANT_ADMIN_PASSWORD=EXIST_PASSWORD
