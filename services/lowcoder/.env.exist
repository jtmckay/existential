# Signs/verifies user API keys (auth.api-key.secret) — regenerating invalidates
# every API key issued so far; integrations using them start getting 401s.
LOWCODER_API_KEY_SECRET=EXIST_32_CHAR_HEX_KEY
# Encrypts secrets lowcoder stores itself (datasource credentials, etc. —
# common.encrypt.password/salt) — regenerating either one leaves existing
# ciphertext undecryptable, breaking every configured datasource.
LOWCODER_DB_ENCRYPTION_PASSWORD=EXIST_32_CHAR_HEX_KEY
LOWCODER_DB_ENCRYPTION_SALT=EXIST_32_CHAR_HEX_KEY

# MongoDB — seeds the root user ONLY on a genuinely empty volume (official mongo
# image behavior, same caveat as any other bundled DB in this repo). Changing
# these after first boot does not change the running server; see volumes.md.
LOWCODER_MONGO_ROOT_USERNAME=EXIST_USERNAME
LOWCODER_MONGO_ROOT_PASSWORD=EXIST_PASSWORD

# Superuser (app login). Unlike the mongo credentials above, api-service
# re-applies this password to the existing account on every boot — verified by
# changing it against an already-initialised volume and confirming the stored
# hash changed after a restart.
LOWCODER_SUPERUSER_USERNAME=EXIST_USERNAME
LOWCODER_SUPERUSER_PASSWORD=EXIST_PASSWORD
