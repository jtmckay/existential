# Postgres
# Role nocodb-postgres creates at first initdb. Baked into its data dir —
# changing this after first boot locks nocodb out of an existing volume.
NOCODB_POSTGRES_USER=EXIST_USERNAME
NOCODB_POSTGRES_PASSWORD=EXIST_PASSWORD

# NocoDB
# NOT a one-time seed: nocodb re-applies both of these to the super-admin
# account on every container boot (verified — a password changed from the
# NocoDB UI itself reverts to this value on the next restart). Change your
# password here, not in the UI, or a restart/update will silently undo it.
NOCODB_ADMIN_EMAIL=EXIST_EMAIL
NOCODB_ADMIN_PASSWORD=EXIST_PASSWORD
