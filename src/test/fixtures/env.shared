# E2E test fixture — committed pre-filled values, not real secrets.
# All EXIST_IS_* start false — e2e.sh enables the relevant ones per quest
# before calling ./existential.sh templates.

# ── Service enablement (all off by default) ───────────────────────────────────

EXIST_IS_AI_CHATTERBOX=false
EXIST_IS_AI_HERMES=false
EXIST_IS_AI_MCP=false
EXIST_IS_AI_OLLAMA=false
EXIST_IS_AI_OPEN_WEBUI=false
EXIST_IS_AI_WHISPERX=false

EXIST_IS_AUTOMATIONS_PLAYWRIGHT=false

EXIST_IS_HOSTING_CADDY=false
EXIST_IS_HOSTING_GRAFANA=false
EXIST_IS_HOSTING_LOKI=false
EXIST_IS_HOSTING_PIHOLE=false
EXIST_IS_HOSTING_PORTAINER=false
EXIST_IS_HOSTING_PROMETHEUS=false
EXIST_IS_HOSTING_UPTIME_KUMA=false

EXIST_IS_NAS_COLLABORA=false
EXIST_IS_NAS_MINIO=false
EXIST_IS_NAS_NEXTCLOUD=false
EXIST_IS_NAS_REDIS=false

EXIST_IS_SERVICES_ACTUAL_BUDGET=false
EXIST_IS_SERVICES_APPSMITH=false
EXIST_IS_SERVICES_DASHY=false
EXIST_IS_SERVICES_AUTOMATION=false
EXIST_IS_SERVICES_HOMEASSISTANT=false
EXIST_IS_SERVICES_IMMICH=false
EXIST_IS_SERVICES_IT_TOOLS=false
EXIST_IS_SERVICES_LOWCODER=false
EXIST_IS_SERVICES_MEALIE=false
EXIST_IS_SERVICES_NOCODB=false
EXIST_IS_SERVICES_NTFY=false

EXIST_NETWORK_EXTERNAL=false

# ── Identity ──────────────────────────────────────────────────────────────────

EXIST_EMAIL=test@test.local
EXIST_USERNAME=testuser
EXIST_PASSWORD=E2eTestPassword24charsXX

# ── Networking ────────────────────────────────────────────────────────────────

EXIST_LOCAL_HOST_IP=127.0.0.1
EXIST_PEER_HOST_IP=127.0.0.1
EXIST_PUBLIC_DOMAIN=
EXIST_DOCKER_NETWORK_SUBNET=10.0.0.0/24

# ── API keys / tokens ─────────────────────────────────────────────────────────

EXIST_HERMES_API_KEY=e2e1000000000000000000000000002a
EXIST_NTFY_URL=http://ntfy:80
# Blank on purpose. A token takes precedence over user/password in
# services/ntfy/exist.test.sh, and ntfy's entrypoint provisions a USER, never
# a token — so a fixture token is one ntfy has never heard of and every
# authenticated publish 401s. .env.exist.shared ships this blank too.
EXIST_NTFY_TOKEN=
EXIST_DECREE_MINIO_WEBHOOK_AUTH_TOKEN=e2e4000000000000000000000000002d

# ── NAS / storage ─────────────────────────────────────────────────────────────

EXIST_NFS_SERVER_ADDRESS=
EXIST_NFS_BASE_PATH=
EXIST_BACKUP_RCLONE_REMOTE=
EXIST_MINIO_DOMAIN=
EXIST_MINIO_SERVER_URL=
EXIST_NEXTCLOUD_DOMAIN=
EXIST_REDIS_PASSWORD=E2eRedisPassword24charsXX

# ── Models ─────────────────────────────────────────────────────────────────────
# e2e runs on whatever box CI gave it, which has no GPU — so it pins the CPU
# vendor and a deliberately tiny model set rather than inheriting the tier
# table's 8 GB defaults from .env.exist.shared. templates.sh only APPENDS keys a
# rendered .env is missing, so pinning them here is what keeps them.
#
# Before this, Core — the flagship quest — needed an ollama on another machine
# (EXIST_E2E_OLLAMA_URL) and skipped by default, so it was never exercised at
# all. These values run on any CPU, so it now runs on every sweep.
#
# What e2e asserts with them is the CONFIGURATION, not inference: the clone
# activates no decree migrations, so the ollama-pull ones never fire and no
# weights are downloaded ("Processed 0 migrations in 0s"). That still matters —
# hermes validates the context window out of its own config.yaml at startup and
# crash-loops on a bad one — but the tags below are picked so that turning the
# pulls on stays affordable, rather than because a pull happens today.
#
# llama3.2:1b is the smallest tag that clears all three constraints at once:
# ollama's `tools` capability (hermes cannot act without it), a native context
# window above the 64,000 hermes hard-refuses to start below, and a KV cache
# small enough to fit in a CI box's RAM. That last one rules out the smaller
# candidates — qwen3:0.6b is a third of the download but tops out at 40,960
# native context, and its geometry costs ~7 GB of KV at 64k against
# llama3.2:1b's 2 GB (16 layers × 8 KV heads × 64 wide; both measured
# via /api/show).
#
# It is not multimodal, so vision is left blank — ollama-pull treats an empty
# role as "off", not as an error. The tier table's CPU row keeps qwen3-vl:2b
# because a real no-GPU install does want images; e2e asserts nothing about them.
EXIST_GPU_VENDOR=none
EXIST_VRAM_GB=0
EXIST_MODEL_CHAT=llama3.2:1b
# The same 64k floor every tier obeys, and here it is load-bearing rather than
# advisory: below it hermes raises "context window ... below the minimum 64,000
# required by Hermes Agent" and refuses to start the agent. It reads the number
# from its own config.yaml, so a lower value fails before ollama is ever asked.
EXIST_MODEL_CHAT_NUM_CTX=65536
EXIST_MODEL_EXTRACT=llama3.2:1b
EXIST_MODEL_VISION=
EXIST_MODEL_EMBED=all-minilm
EXIST_MODEL_EMBED_DIM=384
