# Existential Stack Configuration
# Run existential.sh script, or copy this file to global.env and fill in your values

#==================================================#
#               Global Configuration               #
#==================================================#

# Service Enablement Configuration
# Set to 'true' to enable a service, 'false' to disable
# Each service corresponds to a subdirectory with docker-compose.yml

# AI Services
EXIST_IS_AI_CHATTERBOX=false
EXIST_IS_AI_COMFYUI=false
EXIST_IS_AI_FIRECRAWL=false
EXIST_IS_AI_HERMES=false
EXIST_IS_AI_HONCHO=false
EXIST_IS_AI_MCP=false
EXIST_IS_AI_OLLAMA=false
EXIST_IS_AI_OPEN_WEBUI=false
EXIST_IS_AI_OPENVIKING=false
EXIST_IS_AI_WHISPERX=false
EXIST_IS_AI_WYOMING_PIPER=false
EXIST_IS_AI_WYOMING_WHISPER=false

# Hosting Services
EXIST_IS_HOSTING_CADDY=true
EXIST_IS_HOSTING_GRAFANA=false
EXIST_IS_HOSTING_LOKI=false
EXIST_IS_HOSTING_PIHOLE=false
EXIST_IS_HOSTING_PORTAINER=false
EXIST_IS_HOSTING_PROMETHEUS=false
EXIST_IS_HOSTING_UPTIME_KUMA=false

# NAS Services
EXIST_IS_NAS_COLLABORA=false
EXIST_IS_NAS_MINIO=false
EXIST_IS_NAS_NEXTCLOUD=false
EXIST_IS_NAS_REDIS=false

# Application Services
EXIST_IS_SERVICES_ACTUAL_BUDGET=false
EXIST_IS_SERVICES_APPSMITH=false
EXIST_IS_SERVICES_CODE_SERVER=false
EXIST_IS_SERVICES_DASHY=false
EXIST_IS_SERVICES_DECREE=false
EXIST_IS_SERVICES_IMMICH=false # Recommended to run this directly from the immich directory (not here)
EXIST_IS_SERVICES_IT_TOOLS=false
EXIST_IS_SERVICES_LOWCODER=false
EXIST_IS_SERVICES_MEALIE=false
EXIST_IS_SERVICES_NOCODB=false
EXIST_IS_SERVICES_NTFY=false
EXIST_IS_SERVICES_HOMEASSISTANT=false

#==================================================#
#                  Model Selection                 #
#==================================================#
# Filled in by ./existential.sh on first run; re-ask with `./existential.sh run models`.
# Full reference: https://existential.company/configuration#models

# GPU vendor: nvidia | amd | none. Ships blank — quest asks, and blank is the record of not-yet-asked.
EXIST_GPU_VENDOR=

# VRAM tier in GB (0 = CPU-only). Ships blank for the same reason as the line above.
EXIST_VRAM_GB=

# Primary chat / reasoning model — hermes and open-webui. Must have ollama's "tools" capability.
EXIST_MODEL_CHAT=gemma4:e2b-it-qat

# Context window for the chat model. 65536 is a FLOOR — hermes breaks below 64,000 tokens.
EXIST_MODEL_CHAT_NUM_CTX=65536

# Background extraction model (honcho's deriver/dialectic). Same tag as chat = one resident model.
EXIST_MODEL_EXTRACT=gemma4:e2b-it-qat

# Vision model — OCR and image chat. Same tag as chat; blank disables image handling.
EXIST_MODEL_VISION=gemma4:e2b-it-qat

# Embedding model for openviking's vector store. Changing it after ingestion corrupts the index.
EXIST_MODEL_EMBED=bge-m3

# Must match the embedding model: bge-m3 → 1024, nomic-embed-text → 768, mxbai-embed-large → 1024.
EXIST_MODEL_EMBED_DIM=1024

# Speech-to-text model for Home Assistant voice (wyoming-whisper, CPU): tiny|base|small|medium|large-v3.
EXIST_MODEL_STT=base

# Language hint for the STT model — beats auto-detect on short commands.
EXIST_MODEL_STT_LANGUAGE=en

# Text-to-speech voice (wyoming-piper, CPU) — samples: https://rhasspy.github.io/piper-samples/
EXIST_MODEL_TTS_VOICE=en_US-lessac-medium

#--------------------------------------------------#
#            Model Endpoints (per role)            #
#--------------------------------------------------#
# Every GPU model role can live on a different machine. Each key below is BLANK
# by default and falls back to EXIST_OLLAMA_URL, so leaving them alone keeps the
# single-box behaviour exactly as it was. Fill one in to move that role's VRAM
# somewhere else — e.g. chat on the 24 GB box, embeddings on the 8 GB one.
# Speech is absent on purpose: wyoming-whisper and wyoming-piper run on CPU, so
# moving them frees no VRAM. Point Home Assistant wherever you like.
# Full reference: https://existential.company/configuration#endpoints

# The default for every ollama role below. A wrong value leaves every model call unreachable.
EXIST_OLLAMA_URL=http://ollama:11434

# Chat / reasoning — hermes, open-webui. The big one; give it the largest card.
EXIST_OLLAMA_URL_CHAT=

# Background extraction — honcho's deriver and dialectic. Steady, low-priority load.
EXIST_OLLAMA_URL_EXTRACT=

# Embeddings — openviking's vector store and honcho. Small model, high call volume.
EXIST_OLLAMA_URL_EMBED=

# Vision / OCR — image processors. Idle most of the time; cheap to park elsewhere.
EXIST_OLLAMA_URL_VISION=

# true if the 'exist' Docker network is created externally; false to let Compose manage it.
EXIST_NETWORK_EXTERNAL=false

# Default email to use in services
EXIST_EMAIL=EXIST_CLI

# Default username to use in services
EXIST_USERNAME=EXIST_CLI
# Default password to use in services
EXIST_PASSWORD=EXIST_24_CHAR_PASSWORD

# Host uid:gid every container runs as. Auto-detected on first run; override only if needed.
# https://existential.company/configuration#identity-and-permissions
# EXIST_PUID=1000
# EXIST_PGID=1000

# IP of the machine running caddy — auto-detected (tailnet address, else LAN). Must stay ABOVE
# EXIST_DOMAIN: the EXIST_NIP_DOMAIN placeholder is derived from it and placeholders resolve top-down.
EXIST_LOCAL_HOST_IP=EXIST_HOST_IP

# Base domain for every `<slug>.<domain>` hostname. Defaults to <ip-with-dashes>.nip.io.
# Never a MagicDNS name — see https://existential.company/how-it-works#hostnames-that-just-work
EXIST_DOMAIN=EXIST_NIP_DOMAIN

# Peer mode only: IP of the services host when caddy runs on a separate front door. Blank = single-host.
# DEFAULT_FROM: EXIST_LOCAL_HOST_IP
EXIST_PEER_HOST_IP=

# Public domain for Let's Encrypt certs alongside the local hostnames. Blank = local-only.
# Requires ports 80+443 forwarded; run `./existential.sh run caddy public-domain` after changing.
EXIST_PUBLIC_DOMAIN=

# Hermes gateway API key — shared by hermes-agent, and open-webui
EXIST_HERMES_API_KEY=EXIST_32_CHAR_HEX_KEY


# NTFY (shared across services) — where finished automations report in.
EXIST_NTFY_URL=http://ntfy:80
# The identity every service publishes as; ntfy's entrypoint creates it on first
# boot and grants it rw on EXIST_NTFY_TOPICS. Nothing logs in as this user.
EXIST_NTFY_USER=exist-bot
EXIST_NTFY_PASSWORD=EXIST_24_CHAR_PASSWORD
# Topic pattern the bot may publish to. Routines pick their own topic names
# (decree, alerts, exist-md, ...), so the default is every topic on your private
# instance; narrow it to e.g. "exist*" only if you also rename those topics.
EXIST_NTFY_TOPICS=*
# Optional bearer token; takes precedence over the user/password above when set.
# Mint one with `./existential.sh run ntfy setup` if you prefer tokens.
EXIST_NTFY_TOKEN=

# Telegram fallback — used by notify.sh when ntfy is unreachable (bot: https://t.me/BotFather)
EXIST_TELEGRAM_BOT_TOKEN=
EXIST_TELEGRAM_CHAT_ID=

# Docker network subnet (must match your docker network create command)
EXIST_DOCKER_NETWORK_SUBNET=10.0.0.0/24

#==================================================#
#                 NAS Configuration                #
#==================================================#
# All blank by default and none is a first-run question — the NAS Storage quest
# (`./existential.sh quest`) fills them in. https://existential.company/configuration#storage

# Host mountpoint of the NFS export, EG /mnt/nas — blank keeps all data under <repo>/volumes/.
EXIST_NFS_HOST_MOUNT=
# NFS Server IP Address (documentation / quest only), EG 192.168.1.8
EXIST_NFS_SERVER_ADDRESS=
# NFS Server Share Base Path (documentation / quest only), EG /mnt/container_data
EXIST_NFS_BASE_PATH=

# Backup destination — any rclone remote ("<remote>:<path>"); set via `./existential.sh run backup-config`.
EXIST_BACKUP_RCLONE_REMOTE=

# EG: minio-api.x.internal
EXIST_MINIO_DOMAIN=
# EG: https://minio-api.x.internal
EXIST_MINIO_SERVER_URL=

# Bearer token minIO uses when posting to the decree /minio webhook endpoint
EXIST_DECREE_MINIO_WEBHOOK_AUTH_TOKEN=EXIST_32_CHAR_HEX_KEY

# S3 access key Nextcloud presents to minIO — a scoped service identity, never the console login.
EXIST_MINIO_NEXTCLOUD_ACCESS_KEY=nextcloud
# Its secret — if it drifts from the identity minIO holds, the /S3 mount lists nothing.
EXIST_MINIO_NEXTCLOUD_SECRET_KEY=EXIST_32_CHAR_HEX_KEY

# EG: https://nextcloud.x.internal
EXIST_NEXTCLOUD_DOMAIN=

EXIST_REDIS_PASSWORD=EXIST_24_CHAR_PASSWORD
