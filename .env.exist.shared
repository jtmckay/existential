# Existential Stack Configuration
# ./existential.sh renders this into .env.shared on the first run; edit that file, never this one.

#==================================================#
#               Global Configuration               #
#==================================================#

# Service Enablement: one flag per service folder. Core (code-server, automation, ntfy)
# ships on; `./existential.sh flow on <name>` turns on what a flow needs.

# AI Services
EXIST_IS_AI_CHATTERBOX=false
EXIST_IS_AI_COMFYUI=false
EXIST_IS_AI_FIRECRAWL=false
EXIST_IS_AI_HERMES=false
EXIST_IS_AI_HONCHO=false
EXIST_IS_AI_MCP=false
EXIST_IS_AI_OLLAMA=false
EXIST_IS_AI_OPEN_WEBUI=false
EXIST_IS_AI_OPENVIKING=false
EXIST_IS_AI_QMD=false
EXIST_IS_AI_WHISPERX=false
EXIST_IS_AI_WYOMING_PIPER=false
EXIST_IS_AI_WYOMING_WHISPER=false

# Hosting Services
EXIST_IS_HOSTING_CADDY=false
EXIST_IS_HOSTING_GRAFANA=false
EXIST_IS_HOSTING_LOKI=false
EXIST_IS_HOSTING_PIHOLE=false
EXIST_IS_HOSTING_PORTAINER=false
EXIST_IS_HOSTING_PROMETHEUS=false
EXIST_IS_HOSTING_UPTIME_KUMA=false

# NAS Services
EXIST_IS_NAS_COLLABORA=false
EXIST_IS_NAS_NEXTCLOUD=false

# Application Services
EXIST_IS_SERVICES_ACTUAL_BUDGET=false
EXIST_IS_SERVICES_APPSMITH=false
EXIST_IS_SERVICES_CODE_SERVER=true
EXIST_IS_SERVICES_DASHY=false
EXIST_IS_SERVICES_AUTOMATION=true
EXIST_IS_SERVICES_AUTOMATION_BACKUP=false
EXIST_IS_SERVICES_AUTOMATION_WEBHOOK=false
EXIST_IS_SERVICES_IMMICH=false
EXIST_IS_SERVICES_IT_TOOLS=false
EXIST_IS_SERVICES_LOWCODER=false
EXIST_IS_SERVICES_MEALIE=false
EXIST_IS_SERVICES_NOCODB=false
EXIST_IS_SERVICES_NTFY=true
EXIST_IS_SERVICES_HOMEASSISTANT=false

#==================================================#
#                  Model Selection                 #
#==================================================#
# Filled in by ./existential.sh on first run; re-ask with `./existential.sh run models`.
# Full reference: https://existential.company/configuration#models

# GPU vendor: nvidia | amd | none. Ships blank — the first run asks, and blank is the record of not-yet-asked.
EXIST_GPU_VENDOR=

# VRAM tier in GB (0 = CPU-only). Ships blank for the same reason as the line above.
EXIST_VRAM_GB=

# Primary chat / reasoning model — hermes and open-webui. Must have ollama's "tools" capability.
EXIST_MODEL_CHAT=gemma4:e2b-it-qat

# Context window for the chat model. 65536 is a FLOOR — hermes breaks below 64,000 tokens.
EXIST_MODEL_CHAT_NUM_CTX=65536

# Background extraction model (honcho's deriver/dialectic). Same tag as chat = one resident model.
EXIST_MODEL_EXTRACT=gemma4:e2b-it-qat

# Vision model — OCR and image chat. Same tag as chat; blank disables image handling.
EXIST_MODEL_VISION=gemma4:e2b-it-qat

# Embedding model for openviking's vector store. Changing it after ingestion corrupts the index.
EXIST_MODEL_EMBED=bge-m3

# Must match the embedding model: bge-m3 → 1024, nomic-embed-text → 768, mxbai-embed-large → 1024.
EXIST_MODEL_EMBED_DIM=1024

# Speech-to-text model for Home Assistant voice (wyoming-whisper, CPU): tiny|base|small|medium|large-v3.
EXIST_MODEL_STT=base

# Language hint for the STT model — beats auto-detect on short commands.
EXIST_MODEL_STT_LANGUAGE=en

# Text-to-speech voice (wyoming-piper, CPU) — samples: https://rhasspy.github.io/piper-samples/
EXIST_MODEL_TTS_VOICE=en_US-lessac-medium

#--------------------------------------------------#
#            Model Endpoints (per role)            #
#--------------------------------------------------#
# Each key is an OpenAI-compatible base URL, ending /v1 — any server that answers
# /v1/chat/completions, on this box or another. The per-role keys
# ship BLANK and fall back to EXIST_MODEL_URL; fill one in to move that role's
# VRAM to another machine. Speech is absent on purpose: it runs on CPU.
# Full reference: https://existential.company/docs/configuration#endpoints--putting-roles-on-different-machines

# The default for every role below. A wrong value leaves every model call unreachable.
EXIST_MODEL_URL=http://ollama:11434/v1

# Chat / reasoning — hermes, decree scripts, the newsletter. The big one; give it the largest card.
EXIST_MODEL_URL_CHAT=

# Background extraction — honcho's deriver and dialectic. Steady, low-priority load.
EXIST_MODEL_URL_EXTRACT=

# Embeddings — openviking's vector store and honcho. Its server must serve /v1/embeddings.
EXIST_MODEL_URL_EMBED=

# Vision / OCR — image processors. Its server must accept images.
EXIST_MODEL_URL_VISION=

# Image/video generation — the comfy routine and caddy. Point it at another box to
# use a ComfyUI you already run (then set EXIST_IS_AI_COMFYUI=false).
EXIST_COMFYUI_URL=http://comfyui:8188

# Admin email for add-ons that create an account; blank = not yet asked, asked when one is first enabled.
EXIST_EMAIL=

# Your login name for ntfy and every admin account the stack creates; blank = not yet asked (Enter gives admin).
EXIST_USERNAME=

# Your password for the same logins; blank = not yet asked (Enter generates one, never printed).
EXIST_PASSWORD=

# Host uid:gid every container runs as. Auto-detected on first run; override only if needed.
# https://existential.company/configuration#identity-and-permissions
# EXIST_PUID=1000
# EXIST_PGID=1000

# This host's Tailscale name (box.tail1234.ts.net), filled in once HTTPS works there. Core's links and ntfy's base URL use it.
EXIST_TAILNET_NAME=

# IP of the machine running caddy — auto-detected (tailnet address, else LAN). Must stay ABOVE
# EXIST_DOMAIN: the EXIST_NIP_DOMAIN placeholder is derived from it and placeholders resolve top-down.
EXIST_LOCAL_HOST_IP=EXIST_HOST_IP

# Base domain for every `<slug>.<domain>` hostname. Defaults to <ip-with-dashes>.nip.io.
# Never a MagicDNS name — see https://existential.company/how-it-works#hostnames-that-just-work
EXIST_DOMAIN=EXIST_NIP_DOMAIN

# Public domain for Let's Encrypt certs alongside the local hostnames. Blank = local-only.
# Requires ports 80+443 forwarded; run `./existential.sh run caddy public-domain` after changing.
EXIST_PUBLIC_DOMAIN=

# Hermes gateway API key — shared by hermes-agent, and open-webui
EXIST_HERMES_API_KEY=EXIST_32_CHAR_HEX_KEY


# NTFY (shared across services) — where finished automations report in.
EXIST_NTFY_URL=http://ntfy:80
# The identity every service publishes as; ntfy's entrypoint creates it on first
# boot and lets it publish to every topic. Nothing logs in as this user.
EXIST_NTFY_USER=exist-bot
EXIST_NTFY_PASSWORD=EXIST_24_CHAR_PASSWORD


#==================================================#
#                 NAS Configuration                #
#==================================================#
# Asked when a service with a NAS volume is first on; each volume's EXIST_NFS_PATH_<VOLUME> is appended below. https://existential.company/configuration#storage

# NFS address of the NAS, EG 10.0.0.5 — blank = not yet asked; none keeps every volume under <repo>/volumes/.
EXIST_NFS_ADDRESS=

# Backup destination — any rclone remote ("<remote>:<path>"); set at the end of `./existential.sh run rclone`.
EXIST_BACKUP_RCLONE_REMOTE=

# Bearer token Nextcloud's file-event webhooks send to decree's /files endpoint — set before first start; Nextcloud stores it once.
EXIST_DECREE_FILES_WEBHOOK_AUTH_TOKEN=EXIST_32_CHAR_HEX_KEY
# Bearer token hermes sends to automation-webhook's /hermes/* endpoints — its only way to queue decree work.
EXIST_HERMES_WEBHOOK_TOKEN=EXIST_32_CHAR_HEX_KEY

# Nextcloud that workspace/ two-way syncs with, EG https://nextcloud.x.internal — blank and the sync never runs.
EXIST_NEXTCLOUD_DOMAIN=
# Nextcloud user the workspace sync logs in as — blank and the sync never runs.
EXIST_NEXTCLOUD_USER=
# App password for that user (Settings > Security), never the login password — blank and the sync never runs.
EXIST_NEXTCLOUD_APP_PASSWORD=
# Folder in that user's Files that mirrors workspace/, created if missing; a new name starts with a merge, never a delete.
EXIST_NEXTCLOUD_WORKSPACE_DIR=workspace
