MINIO_ROOT_USER=EXIST_USERNAME
MINIO_ROOT_PASSWORD=EXIST_PASSWORD
MINIO_DOMAIN=EXIST_MINIO_DOMAIN
MINIO_SERVER_URL=EXIST_MINIO_SERVER_URL

# Bearer token minIO sends to the decree /minio webhook endpoint. Rendered from the
# shared token, as is the matching secret in services/automation/webhook/config.yml.
MINIO_DECREE_WEBHOOK_AUTH_TOKEN=EXIST_DECREE_MINIO_WEBHOOK_AUTH_TOKEN

# Nextcloud's scoped S3 identity, created in minIO by the minio-service-account
# routine. Rendered from the shared pair nextcloud reads, so the two cannot drift.
MINIO_NEXTCLOUD_ACCESS_KEY=EXIST_MINIO_NEXTCLOUD_ACCESS_KEY
MINIO_NEXTCLOUD_SECRET_KEY=EXIST_MINIO_NEXTCLOUD_SECRET_KEY
