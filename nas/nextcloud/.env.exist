# CIDR of the docker bridge caddy sits on. Nextcloud matches trusted_proxies
# against IP addresses, NOT hostnames — 'caddy' silently fails to match, and
# then every client looks like the proxy ('remote address could not be
# determined'), which disables brute-force throttling and rate limits.
# Trusting the network rather than a pinned container IP keeps this correct
# when caddy is recreated and its address moves. Mirrors homeassistant's
# http.trusted_proxies (see services/homeassistant/exist.initial.sh).
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
# Blank by default — docker-compose derives nextcloud.$EXIST_DOMAIN at container
# start, so changing EXIST_DOMAIN needs no re-render. Set a literal hostname here
# only to override that.
NEXTCLOUD_DOMAIN=
NEXTCLOUD_PROTOCOL=https
NEXTCLOUD_ADMIN_USER=EXIST_USERNAME
NEXTCLOUD_ADMIN_PASSWORD=EXIST_PASSWORD
NEXTCLOUD_SQL_USER=EXIST_USERNAME
NEXTCLOUD_SQL_PASSWORD=EXIST_24_CHAR_PASSWORD
NEXTCLOUD_ROOT_PASSWORD=EXIST_24_CHAR_PASSWORD

# --requirepass value nextcloud-redis starts with; nextcloud authenticates with
# the same key, so the two cannot drift. A mismatch throws Redis connection
# errors from file locking and the session handler, not a graceful fallback.
NEXTCLOUD_REDIS_PASSWORD=EXIST_24_CHAR_PASSWORD
