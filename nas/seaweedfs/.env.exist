# Admin UI login at https://seaweedfs.<domain>, and the S3 root identity in s3.json.
SEAWEEDFS_ROOT_USER=EXIST_USERNAME
# Its secret — also the S3 root secret key; if it drifts from s3.json, every routine 401s.
SEAWEEDFS_ROOT_PASSWORD=EXIST_PASSWORD

# Bearer token SeaweedFS sends to the decree /s3 webhook endpoint. Rendered from the
# shared token, as is the matching secret in services/automation/webhook/config.yml.
SEAWEEDFS_DECREE_WEBHOOK_AUTH_TOKEN=EXIST_DECREE_S3_WEBHOOK_AUTH_TOKEN

# Nextcloud's scoped S3 identity, declared in s3.json. Rendered from the same shared
# pair nas/nextcloud/.env reads, so the two cannot drift.
SEAWEEDFS_NEXTCLOUD_ACCESS_KEY=EXIST_S3_NEXTCLOUD_ACCESS_KEY
SEAWEEDFS_NEXTCLOUD_SECRET_KEY=EXIST_S3_NEXTCLOUD_SECRET_KEY
