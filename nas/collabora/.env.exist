COLLABORA_USERNAME=EXIST_USERNAME
COLLABORA_PASSWORD=EXIST_PASSWORD
# Derived from EXIST_DOMAIN in docker-compose.exist.yml. Uncomment to override.
# COLLABORA_DOMAIN=collabora.example.com

# Nextcloud's domain — becomes coolwsd's WOPI host allowlist (aliasgroup1 in
# docker-compose.exist.yml), the one host collabora will accept as the source of
# documents to open. Derived from EXIST_DOMAIN. Uncomment to override.
# COLLABORA_NEXTCLOUD_DOMAIN=nextcloud.example.com
