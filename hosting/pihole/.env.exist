PIHOLE_PASSWORD=EXIST_PASSWORD
# tz database name — wrong value only skews query-log timestamps.
PIHOLE_TZ=UTC

# The wildcard record's IPs come from EXIST_LOCAL_HOST_IP / EXIST_PEER_HOST_IP in
# .env.shared; they reach compose substitution via the generated master .env.
#
# After bringing piHole up, point your LAN router's primary DNS at this machine
# so `<slug>.<domain>` resolves correctly across the network.
