// Alloy's own config language, not YAML. Replaces loki-promtail-config.yaml
// (promtail is EOL). Generated with `alloy convert --source-format=promtail`,
// then simplified: the two decree jobs shared a pipeline and are now one.

// decree runs, from both projects (automation, automation-backup). decree 0.5
// writes each run's record as runs/<id>/events.jsonl and each script's output
// as runs/<id>/<NNNN>-<state>-<script>.log; it has no exporter on purpose — the
// event log is the telemetry. This is decree's examples/observability/
// config.alloy, with a `daemon` label for which project a run belongs to.
// These labels are a contract: grafana's decree dashboards and the decree alert
// query them.
loki.source.file "decree_events" {
	targets = [
		{ __path__ = "/decree/automation/*/events.jsonl", job = "decree", daemon = "automation" },
		{ __path__ = "/decree/automation-backup/*/events.jsonl", job = "decree", daemon = "automation-backup" },
	]
	forward_to = [loki.process.decree_events.receiver]

	file_match {
		enabled = true
	}
}

loki.process "decree_events" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = { ts = "", type = "", machine = "", run_id = "" }
	}
	// decree's own timestamp, not the time alloy read the line.
	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}
	// Low cardinality only. run_id is metadata, never a label.
	stage.labels {
		values = { type = "", machine = "" }
	}
	stage.structured_metadata {
		values = { run_id = "" }
	}
	// Prometheus metrics from each run's last line, served on alloy's own
	// /metrics, which Prometheus scrapes.
	stage.match {
		selector = "{type=\"run_finished\"}"
		stage.json {
			expressions = { state = "", duration_ms = "" }
		}
		stage.labels {
			values = { state = "" }
		}
		// A metric takes the line's labels; filename names the run, so it would
		// make one series per run.
		stage.label_drop {
			values = ["filename"]
		}
		stage.metrics {
			// decree_runs_total{job, daemon, machine, state, type}: success is state="done".
			// max_idle_duration outlasts a weekly backup, so its series survives
			// between runs for BackupNotRun to see.
			metric.counter {
				name              = "runs_total"
				prefix            = "decree_"
				description       = "Finished decree runs, by machine and final state."
				match_all         = true
				action            = "inc"
				max_idle_duration = "192h"
			}
			metric.histogram {
				name              = "run_duration_milliseconds"
				prefix            = "decree_"
				description       = "Wall time of finished decree runs."
				source            = "duration_ms"
				buckets           = [1000, 10000, 60000, 300000, 900000, 3600000, 14400000]
				max_idle_duration = "192h"
			}
		}
	}
}

// Each script's stdout+stderr. State and script names cannot contain "-", so
// the path regex is unambiguous.
loki.source.file "decree_script_output" {
	targets = [
		{ __path__ = "/decree/automation/*/[0-9]*.log", job = "decree_script", daemon = "automation" },
		{ __path__ = "/decree/automation-backup/*/[0-9]*.log", job = "decree_script", daemon = "automation-backup" },
	]
	forward_to = [loki.process.decree_script_output.receiver]

	file_match {
		enabled = true
	}
}

loki.process "decree_script_output" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		source     = "filename"
		expression = "/(?P<run_id>[^/]+)/(?P<n>\\d{4,})-(?P<state>[^-]+)-(?P<script>[^/]+)\\.log$"
	}
	stage.labels {
		values = { script = "" }
	}
	stage.structured_metadata {
		values = { run_id = "", state = "" }
	}
}

// hermes' own log files. It logs to files under $HERMES_HOME/logs, never to
// stdout, so the docker_containers job below cannot see it at all (`docker
// logs hermes-agent` is empty) — without this job, hermes is the one core
// service with no trace in grafana. What lands here: the cron scheduler's
// start/tick lines per profile, `tool <name> completed` for every tool call
// the agent makes, and the python tracebacks from errors.log.
//
// `gateways/**` is one subdirectory per multiplexed profile (default, router,
// research, sales), so the profile name is in `filename` when you need it.
loki.source.file "hermes" {
	// Not a `*.log` glob, for two reasons: errors.log is a strict subset of
	// agent.log (verified line for line — tailing both shows every error
	// twice), and dashboard-auth.log is JSON, handled by its own job below.
	targets = [
		{ __path__ = "/hermes-logs/agent.log", job = "hermes" },
		{ __path__ = "/hermes-logs/gateway*.log", job = "hermes" },
		{ __path__ = "/hermes-logs/container-boot.log", job = "hermes" },
		{ __path__ = "/hermes-logs/gui.log", job = "hermes" },
		{ __path__ = "/hermes-logs/gateways/**/*.log", job = "hermes" },
	]
	forward_to = [loki.process.hermes.receiver]

	file_match {
		enabled = true
	}
}

loki.process "hermes" {
	forward_to = [loki.write.default.receiver]

	// Python logging writes a traceback as N bare lines after the record that
	// introduced it. Without this each frame is its own loki entry, and the one
	// line naming the exception is separated from the one naming the file. A
	// record always starts with its date, so anything else continues the one
	// before it.
	stage.multiline {
		firstline = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
	}

	// `2026-09-14 23:32:16,318 INFO module.name: message`
	stage.regex {
		expression = "^(?P<ts>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}),\\d+ (?P<level>[A-Z]+) "
	}

	// Low cardinality and the whole point of the job — `{job="hermes",
	// level="ERROR"}` is the query worth having. The module name is
	// deliberately NOT a label: it is unbounded, and line-level filtering
	// handles it.
	stage.labels {
		values = {
			level = null,
		}
	}

	// Without this every line carries its read time, so a first tail of an
	// existing log file lands the whole backlog at "now". Comma-separated
	// milliseconds are dropped by the regex above because Go's reference layout
	// has no form for them — second precision is enough to order a log.
	//
	// Note loki rejects samples older than reject_old_samples_max_age (168h in
	// loki-config.yaml), so lines older than a week are dropped rather than
	// backdated. That only bites on a first tail of a long-lived file; alloy
	// logs the rejection.
	stage.timestamp {
		source            = "ts"
		format            = "2006-01-02 15:04:05"
		action_on_failure = "skip"
	}
}

// Who logged into the hermes dashboard, and from where. One JSON object per
// line (`login_success`, `ws_ticket_minted`, … with user_id and ip), so it
// needs its own pipeline rather than the python-text one above — same `job`,
// separated by `log_type` the way the decree targets do it.
loki.source.file "hermes_auth" {
	targets = [
		{ __path__ = "/hermes-logs/dashboard-auth.log", job = "hermes", log_type = "auth" },
	]
	forward_to = [loki.process.hermes_auth.receiver]

	file_match {
		enabled = true
	}
}

loki.process "hermes_auth" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			ts    = "ts",
			event = "event",
		}
	}

	// `event` is a fixed vocabulary, so it is safe as a label. user_id and ip
	// are not labels on purpose: both are unbounded, and the line still has
	// them for filtering.
	stage.labels {
		values = {
			event = null,
		}
	}

	stage.timestamp {
		source            = "ts"
		format            = "RFC3339"
		action_on_failure = "skip"
	}
}

// Every container's json-file log. No docker socket, so these carry only the
// 64-hex container id in `filename` — a catch-all grep, not a per-service
// view. The id *could* be resolved to a name without the socket (root can
// read the sibling .../<id>/config.v2.json's "Name" field — verified), but
// that's an undocumented internal docker state file with no compatibility
// guarantee across engine versions, which is a worse trade than an id you can
// `docker inspect` by hand.
loki.source.file "docker_containers" {
	targets = [
		{ __path__ = "/var/lib/docker/containers/*/*.log", job = "docker" },
	]
	forward_to = [loki.process.docker_containers.receiver]

	file_match {
		enabled = true
	}

	legacy_positions_file = "/var/lib/alloy/data/positions.yaml"
}

loki.process "docker_containers" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			log    = "log",
			stream = "stream",
			time   = "time",
		}
	}

	stage.labels {
		values = {
			stream = null,
		}
	}

	stage.timestamp {
		source = "time"
		format = "RFC3339Nano"
	}

	stage.output {
		source = "log"
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
