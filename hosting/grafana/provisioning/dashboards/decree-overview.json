{
  "description": "decree runs from both projects: outcomes, durations and recent runs. Metrics come from alloy's stage.metrics over each run's events.jsonl; runs are the run_finished lines in Loki.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "instant": true, "legendFormat": "{{machine}} done", "expr": "round(sum by (machine) (increase(decree_runs_total{daemon=~\"$daemon\", machine=~\"$machine\", state=\"done\"}[$__range])))" },
        { "refId": "B", "instant": true, "legendFormat": "{{machine}} failed", "expr": "round(sum by (machine) (increase(decree_runs_total{daemon=~\"$daemon\", machine=~\"$machine\", state!=\"done\"}[$__range]))) > 0" }
      ],
      "title": "Runs in range",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "refId": "A", "legendFormat": "{{machine}}", "expr": "histogram_quantile(0.95, sum by (machine, le) (rate(decree_run_duration_milliseconds_bucket{daemon=~\"$daemon\", machine=~\"$machine\"}[1h])))" }
      ],
      "title": "Run duration (p95, 1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "done" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        { "refId": "A", "legendFormat": "{{state}}", "interval": "1h", "expr": "sum by (state) (increase(decree_runs_total{daemon=~\"$daemon\", machine=~\"$machine\"}[$__interval]))" }
      ],
      "title": "Finished runs per hour, by final state",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "duration_ms" }, "properties": [{ "id": "unit", "value": "ms" }] },
          {
            "matcher": { "id": "byName", "options": "state" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [{ "type": "value", "options": { "done": { "color": "green" } } }, { "type": "regex", "options": { "pattern": ".*", "result": { "color": "red" } } }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "run_id" },
            "properties": [
              { "id": "links", "value": [{ "title": "View run", "url": "/d/decree-run-detail/decree-run-detail?var-run_id=${__value.raw}&from=${__from}&to=${__to}" }] }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "id": 4,
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] },
      "targets": [
        { "refId": "A", "queryType": "range", "maxLines": 200, "expr": "{job=\"decree\", daemon=~\"$daemon\", type=\"run_finished\", machine=~\"$machine\"}" }
      ],
      "title": "Recent runs",
      "transformations": [
        { "id": "extractFields", "options": { "source": "Line", "format": "json" } },
        { "id": "filterFieldsByName", "options": { "include": { "names": ["Time", "machine", "state", "duration_ms", "trigger", "run_id"] } } }
      ],
      "type": "table"
    }
  ],
  "schemaVersion": 39,
  "tags": ["decree", "automation"],
  "templating": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(decree_runs_total, daemon)",
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "name": "daemon",
        "label": "Daemon",
        "query": { "query": "label_values(decree_runs_total, daemon)", "refId": "daemon" },
        "refresh": 2,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(decree_runs_total{daemon=~\"$daemon\"}, machine)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "name": "machine",
        "label": "Machine",
        "query": { "query": "label_values(decree_runs_total{daemon=~\"$daemon\"}, machine)", "refId": "machine" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "title": "Decree Overview",
  "uid": "decree-overview",
  "version": 2
}
